digraph caissa {
  graph [rankdir=LR, bgcolor="white", label="Typed component boundaries", labelloc=t, fontsize=20, fontname="Helvetica", pad="0.3"];
  node [shape=box, style="rounded,filled", fillcolor="#edf2e5", color="#60734d", fontname="Helvetica", fontsize=11, margin="0.15"];
  edge [color="#60734d", fontname="Helvetica", fontsize=9];
  position [label="Position + Undo"];
  attacks [label="Bitboard rays"];
